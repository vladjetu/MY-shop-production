SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
ZAKEKE_CLIENT_ID=
ZAKEKE_CLIENT_SECRET=
APP_PASSWORD=
# Verejná URL nasadenej appky (bez lomítka na konci), napr. https://my-shop-production.vercel.app
# Používa ju /api/admin/register-webhook na zostavenie callbackUrl pre Shopify webhook.
APP_BASE_URL=
# SAP integrácia (docs/SAP-INTEGRATION.md) — zdieľaný secret s SAP agentom na AVD,
# hlavička x-sap-sync-secret pri POST /api/sap-sync. Dlhý náhodný reťazec.
SAP_SYNC_SECRET=
# Upstash Redis pre SAP snapshot — nastaví Vercel Marketplace (Storage → Upstash for Redis).
# Lokálne: vercel env pull .env.local. Appka používa KV_REST_API_URL + KV_REST_API_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=
